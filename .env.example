# Пример файла настроек. Скопируйте в .env и поправьте под себя:
#   copy .env.example .env

# Каталог с исходными файлами (относительно корня проекта)
NN_DATA_DIR=data/input

# Каталог для результатов
NN_OUTPUT_DIR=data/output

# Расширения файлов для команды prepare
NN_EXTENSIONS=.jpg,.jpeg,.png,.bmp

# Сторона изображения после масштабирования
NN_IMAGE_SIZE=64

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
NN_LOG_LEVEL=INFO

# Файл лога
NN_LOG_FILE=logs/prepare.log

# Ограничение числа файлов, 0 - без ограничения
NN_MAX_FILES=0
